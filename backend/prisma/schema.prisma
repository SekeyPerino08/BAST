// Prisma Client and the Neon PostgreSQL connection are configured here.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  ALUMNI
}

enum Sex {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  DROPPED
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ImportType {
  STUDENTS
  TEACHERS
}

enum ImportStatus {
  PREVIEWED
  COMMITTED
  DISCARDED
  EXPIRED
}

enum LmsEventType {
  LOGIN
  SUBMISSION
  QUIZ
}

enum AlumniRecordKind {
  DONATION
  EVENT
  MENTORING
}

enum FeedImportMode {
  PREVIEW
  COMMIT
}

enum AnnouncementCategory {
  SCHOOL
  CLASS
  SUBJECT
}

enum AssignmentStatus {
  UPCOMING
  PENDING
  SUBMITTED
  LATE
  GRADED
  CLOSED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  LATE
  GRADED
}

enum DocumentRequestType {
  CERTIFICATE_OF_ENROLLMENT
  CERTIFICATE_OF_GOOD_MORAL_CHARACTER
  TRANSCRIPT_OF_RECORDS
  REPORT_CARD
  CERTIFICATE_OF_COMPLETION
  OTHER
}

enum DocumentRequestStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ANNOUNCEMENT
  ASSIGNMENT
  ATTENDANCE
  GRADE
  SCHEDULE
  DOCUMENT
  REMINDER
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  loginId            String?         @unique
  passwordHash       String
  role               Role
  firstName          String
  lastName           String
  isActive           Boolean         @default(true)
  mustChangePassword Boolean         @default(false)
  passwordChangedAt  DateTime?
  tokenVersion       Int             @default(0)
  failedLoginCount   Int             @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  student            Student?
  teacher            Teacher?
  auditLogs          AuditLog[]
  attendanceRecords  Attendance[]    @relation("AttendanceRecorder")
  recordedGrades     Grade[]         @relation("GradeRecorder")
  lockedTerms        Term[]          @relation("TermLocker")
  releasedTerms      Term[]          @relation("TermReleaser")
  importJobs         ImportJob[]
  feedImportRuns     FeedImportRun[]
  passwordResetTokens PasswordResetToken[]
  announcementsCreated Announcement[] @relation("AnnouncementCreator")
  notifications       Notification[]
}

model Student {
  id                String         @id @default(cuid())
  studentNo         String         @unique
  userId            String?        @unique
  firstName         String
  middleName        String?
  lastName          String
  sex               Sex
  birthDate         DateTime?
  address           String?
  guardianName      String?
  guardianContact   String?
  status            StudentStatus  @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments       Enrollment[]
  attendanceRecords Attendance[]
  grades            Grade[]
  lmsEvents         LmsEvent[]
  libraryLoans      LibraryLoan[]
  alumniRecords     AlumniRecord[]
  submissions       AssignmentSubmission[]
  documentRequests  DocumentRequest[]
  notifications    Notification[]
  schedules        ClassSchedule[]

  @@index([userId])
}

model Teacher {
  id              String          @id @default(cuid())
  employeeNo      String          @unique
  userId          String?         @unique
  firstName       String
  middleName      String?
  lastName        String
  department      String?
  contactNo       String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  offerings       ClassOffering[]
  advisedSections Section[]       @relation("SectionAdviser")
  assignments     Assignment[]
  learningMaterials LearningMaterial[]
  schedules       ClassSchedule[]

  @@index([userId])
}

model SchoolYear {
  id             String          @id @default(cuid())
  name           String          @unique
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  terms          Term[]
  enrollments    Enrollment[]
  classOfferings ClassOffering[]
  sections       Section[]
}

model Term {
  id           String     @id @default(cuid())
  schoolYearId String
  name         String
  termNumber   Int
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  schoolYear   SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  grades       Grade[]
  gradesLocked Boolean    @default(false)
  lockedAt     DateTime?
  lockedById   String?
  lockedBy     User?      @relation("TermLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  gradesReleasedAt   DateTime?
  gradesReleasedById String?
  gradesReleasedBy   User?      @relation("TermReleaser", fields: [gradesReleasedById], references: [id], onDelete: SetNull)

  @@unique([schoolYearId, termNumber])
  @@index([schoolYearId])
  @@index([lockedById])
  @@index([gradesReleasedById])
}

model Subject {
  id                String             @id @default(cuid())
  code              String             @unique
  name              String
  description       String?
  gradeLevel        Int
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  classOfferings    ClassOffering[]
  lmsEvents         LmsEvent[]
  announcements     Announcement[]
  assignments       Assignment[]
  learningMaterials LearningMaterial[]
  schedules         ClassSchedule[]
}

model Section {
  id             String          @id @default(cuid())
  name           String
  gradeLevel     Int
  schoolYearId   String
  adviserId      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  schoolYear     SchoolYear      @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  adviser        Teacher?        @relation("SectionAdviser", fields: [adviserId], references: [id], onDelete: SetNull)
  enrollments    Enrollment[]
  classOfferings ClassOffering[]
  schedules      ClassSchedule[]

  @@unique([schoolYearId, gradeLevel, name])
  @@unique([schoolYearId, adviserId])
  @@index([schoolYearId])
  @@index([adviserId])
}

model Enrollment {
  id           String           @id @default(cuid())
  studentId    String
  schoolYearId String
  sectionId    String?
  status       EnrollmentStatus @default(ENROLLED)
  enrolledAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  schoolYear   SchoolYear       @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  section      Section?         @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([studentId, schoolYearId])
  @@index([studentId])
  @@index([schoolYearId])
  @@index([sectionId])
}

model ClassOffering {
  id                String             @id @default(cuid())
  subjectId         String
  sectionId         String
  teacherId         String
  schoolYearId      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  section           Section            @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  teacher           Teacher            @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  schoolYear        SchoolYear         @relation(fields: [schoolYearId], references: [id], onDelete: Restrict)
  attendance        Attendance[]
  grades            Grade[]
  announcements     Announcement[]
  assignments       Assignment[]
  learningMaterials LearningMaterial[]
  schedules         ClassSchedule[]

  @@unique([subjectId, sectionId, schoolYearId])
  @@index([subjectId])
  @@index([sectionId])
  @@index([teacherId])
  @@index([schoolYearId])
}

model Announcement {
  id             String              @id @default(cuid())
  title          String
  body           String
  category       AnnouncementCategory @default(SCHOOL)
  isPinned       Boolean             @default(false)
  publishedAt    DateTime            @default(now())
  expiresAt      DateTime?
  createdById    String?
  classOfferingId String?
  subjectId      String?
  attachments    String[]
  createdBy      User?               @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  classOffering  ClassOffering?      @relation(fields: [classOfferingId], references: [id], onDelete: SetNull)
  subject        Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([category, publishedAt])
  @@index([classOfferingId])
  @@index([subjectId])
}

model Assignment {
  id              String          @id @default(cuid())
  title           String
  description     String?
  instructions    String?
  dueAt           DateTime
  publishedAt     DateTime        @default(now())
  maxScore        Decimal?        @db.Decimal(5, 2)
  subjectId       String
  classOfferingId String
  teacherId       String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subject         Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classOffering   ClassOffering   @relation(fields: [classOfferingId], references: [id], onDelete: Restrict)
  teacher         Teacher         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  submissions     AssignmentSubmission[]

  @@index([subjectId])
  @@index([classOfferingId])
  @@index([teacherId])
  @@index([dueAt])
}

model AssignmentSubmission {
  id           String          @id @default(cuid())
  assignmentId String
  studentId    String
  fileName     String?
  fileUrl      String?
  notes        String?
  submittedAt  DateTime?
  status       SubmissionStatus @default(SUBMITTED)
  grade        Decimal?        @db.Decimal(5, 2)
  feedback     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assignment   Assignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student      Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
}

model LearningMaterial {
  id              String        @id @default(cuid())
  title           String
  description     String?
  fileName        String
  fileUrl         String
  fileType        String
  uploadedAt      DateTime      @default(now())
  isRestricted    Boolean       @default(false)
  teacherId       String
  subjectId       String?
  classOfferingId String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  teacher         Teacher       @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  subject         Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  classOffering   ClassOffering? @relation(fields: [classOfferingId], references: [id], onDelete: SetNull)

  @@index([subjectId])
  @@index([classOfferingId])
  @@index([teacherId])
}

model ClassSchedule {
  id              String        @id @default(cuid())
  studentId       String
  sectionId       String
  subjectId       String
  teacherId       String?
  classOfferingId String?
  schoolYearId    String
  dayOfWeek       String
  startTime       String
  endTime         String
  room            String?
  notes           String?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  section         Section       @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher         Teacher?      @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  classOffering   ClassOffering? @relation(fields: [classOfferingId], references: [id], onDelete: SetNull)

  @@index([studentId, schoolYearId])
  @@index([sectionId])
  @@index([classOfferingId])
}

model DocumentRequest {
  id            String               @id @default(cuid())
  studentId     String
  documentType  DocumentRequestType
  reason        String?
  details       String?
  status        DocumentRequestStatus @default(PENDING)
  requestedAt   DateTime             @default(now())
  processedAt   DateTime?
  adminRemarks  String?
  documentUrl   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  student       Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, requestedAt])
  @@index([status])
}

model Notification {
  id        String         @id @default(cuid())
  userId    String
  studentId String?
  type      NotificationType
  title     String
  message   String
  actionUrl String?
  isRead    Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  student   Student?       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([studentId])
}

model Attendance {
  id              String           @id @default(cuid())
  studentId       String
  classOfferingId String
  date            DateTime         @db.Date
  status          AttendanceStatus
  remarks         String?
  recordedById    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classOffering   ClassOffering    @relation(fields: [classOfferingId], references: [id], onDelete: Restrict)
  recordedBy      User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, classOfferingId, date])
  @@index([studentId])
  @@index([classOfferingId])
  @@index([recordedById])
}

model Grade {
  id              String        @id @default(cuid())
  studentId       String
  classOfferingId String
  termId          String
  score           Decimal       @db.Decimal(5, 2)
  remarks         String?
  recordedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classOffering   ClassOffering @relation(fields: [classOfferingId], references: [id], onDelete: Restrict)
  term            Term          @relation(fields: [termId], references: [id], onDelete: Restrict)
  recordedBy      User?         @relation("GradeRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([studentId, classOfferingId, termId])
  @@index([studentId])
  @@index([classOfferingId])
  @@index([termId])
  @@index([recordedById])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
}

model AuditEntry {
  id          String    @id @default(cuid())
  at          DateTime  @default(now()) @db.Timestamptz(6)
  actorUserId String?   @map("actor_user_id")
  actorRole   Role?     @map("actor_role")
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  studentId   String?   @map("student_id")
  before      Json?
  after       Json?
  ip          String?
  @@index([studentId, at])
  @@index([actorUserId, at])
  @@index([at])
  @@map("audit_log")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  consumedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ImportJob {
  id          String       @id @default(cuid())
  type        ImportType
  status      ImportStatus @default(PREVIEWED)
  fileName    String
  fileHash    String
  options     Json
  totals      Json
  rows        Json?
  expiresAt   DateTime
  createdById String?
  committedAt DateTime?
  result      Json?
  createdAt   DateTime     @default(now())
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([status, expiresAt])
}

model LmsEvent {
  id         String       @id @default(cuid())
  studentId  String       @map("student_id")
  courseId   String?      @map("course_id")
  type       LmsEventType
  occurredAt DateTime     @map("occurred_at")
  score      Decimal?     @db.Decimal(5, 2)
  onTime     Boolean?     @map("on_time")
  externalId String       @map("external_id")
  source     String
  student    Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  course     Subject?     @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([studentId, occurredAt])
  @@map("lms_events")
}

model LibraryLoan {
  id         String    @id @default(cuid())
  studentId  String    @map("student_id")
  bookTitle  String    @map("book_title")
  loanedOn   DateTime  @map("loaned_on") @db.Date
  dueOn      DateTime  @map("due_on") @db.Date
  returnedOn DateTime? @map("returned_on") @db.Date
  externalId String    @map("external_id")
  source     String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([source, externalId])
  @@index([studentId, dueOn])
  @@map("library_loans")
}

model AlumniRecord {
  id         String           @id @default(cuid())
  studentId  String           @map("student_id")
  kind       AlumniRecordKind
  amount     Decimal?         @db.Decimal(12, 2)
  occurredOn DateTime         @map("occurred_on") @db.Date
  detail     String?
  externalId String           @map("external_id")
  source     String
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([source, externalId])
  @@index([studentId, occurredOn])
  @@map("alumni_records")
}

model FeedImportRun {
  id         String             @id @default(cuid())
  source     String
  mode       FeedImportMode
  startedAt  DateTime           @default(now()) @map("started_at")
  finishedAt DateTime?          @map("finished_at")
  received   Int                @default(0)
  accepted   Int                @default(0)
  rejected   Int                @default(0)
  runById    String?            @map("run_by")
  runBy      User?              @relation(fields: [runById], references: [id], onDelete: SetNull)
  rejects    FeedImportReject[]

  @@index([source, startedAt])
  @@index([runById])
  @@map("import_runs")
}

model FeedImportReject {
  id        String        @id @default(cuid())
  runId     String        @map("run_id")
  rowNumber Int           @map("row_number")
  raw       Json
  reason    String
  run       FeedImportRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, rowNumber])
  @@index([runId])
  @@map("import_rejects")
}
