{
  "name": "mnhs-school-system-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "test:unit": "tsx scripts/attendance.unit.ts && tsx scripts/grading.unit.ts && tsx scripts/report-card.unit.ts && tsx scripts/dashboard.unit.ts && tsx scripts/security-governance.unit.ts && tsx scripts/import-csv.unit.ts && tsx scripts/reports.unit.ts && tsx scripts/integrations.unit.ts && tsx scripts/audit.unit.ts",
    "test:security": "vitest run tests/security.test.ts",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:integrations": "tsx scripts/integrations.integration.ts",
    "test:audit-integration": "tsx scripts/audit.integration.ts",
    "test:ci": "npm run build && npm run test:types && npm run test:unit && npm run test:security && npm run test:integrations && npm run test:audit-integration"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.1.0"
  }
}
